{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [".opencode/rules/*.md"],
  "plugin": ["@dietrichgebert/ponytail", "opencode-caveman"],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "duckduckgo": {
      "type": "local",
      "command": ["bunx", "-y", "duckduckgo-websearch"],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "css-sync": "allow",
          "db-schema": "allow",
          "webform-scaffold": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "css-sync": "allow",
          "db-schema": "allow",
          "webform-scaffold": "allow"
        }
      }
    }
  }
}
