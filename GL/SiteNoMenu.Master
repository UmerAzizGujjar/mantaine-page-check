<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteNoMenu.Master.cs"
    Inherits="PMS.SiteNoMenu" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en">
<head id="Head1" runat="server">
    <title>TIBBIT</title>
    <link rel="icon" type="image/x-icon" href="wwwroot/IITH_Theme/images/HMIS_Icons/Icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="wwwroot/IITH_Theme/Styles/ace-rtl.min.css" rel="stylesheet" />
    <link href="wwwroot/IITH_Theme/Styles/bootstrap.min.css" rel="stylesheet" />
    <link href="wwwroot/IITH_Theme/css/CustomCss/LoginPage.css" rel="stylesheet" />



    <link href="wwwroot/IITH_Theme/Styles/loader.css" rel="stylesheet" />
    <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <style type="text/css">
        /* Import Google Fonts */
        @import url("https://fonts.googleapis.com/css2?family=Open+Sans:wght@200;300;400;500;600;700&display=swap");

      
      

        /* Responsive design */
        @media (max-width: 1280px) {
            body {
                background: none !important; /* Hides the background image */
                }
            .wrapper {
                width: 80%;
                top: 15%;
                left: 50%;
                transform: translateX(-55%);
            }
        }

        @media (min-width: 1289px) and (max-width: 2000px) {
            
            .wrapper {
                width: 80%;
                top: 14%;
                right: 68%;

            }
        }

        @media (max-width: 1024px) {
             body {
                background: none !important; /* Hides the background image */
                }
               .wrapper {
                width: 90%;
                top: 15%;
                left: 50%;
              
            }

        }


        @media (min-width: 480px) and (max-width: 768px) {

            .wrapper {
                width: 100%;
                top: 15%;
                left: 55%;
            }
        }

        /* Responsive image styling */
        .Image1 {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            position: relative;
            left: 50%;
        }
    </style>
    <style type="text/css">
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Open Sans", sans-serif;
        }

        h1, h4 {
            margin-bottom: 0 !important;
        }

        /* Styling for the main wrapper */
        .wrapper {
            max-width: 460px;
            padding: 0px 20px 20px 20px;
            text-align: center;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(4px);
            position: absolute;
            right: 10%;
            margin-top:-40px !important;
            border: 1px solid #e3dddd;
            border-radius: 12px;
        }


        /* Form styling */
        form {
            display: flex;
            flex-direction: column;
            width: 100%;
        }

        /* Link styling */


        /* Input field styling */
        .input-field {
            position: relative;
        }

            .input-field label {
                position: absolute;
                top: 50%;
                left: 0;
                transform: translateY(-50%);
                color: #fff;
                font-size: 16px;
                pointer-events: none;
                transition: 0.15s ease;
            }

            .input-field input {
                width: 100%;
                height: 40px;
                outline: none;
                font-size: 16px;
                color: #fff;
            }

                .input-field input:focus ~ label,
                .input-field input:valid ~ label {
                    font-size: 0.8rem;
                    top: 10px;
                    transform: translateY(-120%);
                }

        /* Button styling */
        button {
            background: #fff;
            color: #000;
            font-weight: 600;
            border: none;
            padding: 12px 20px;
            cursor: pointer;
            border-radius: 3px;
            font-size: 16px;
            border: 2px solid transparent;
            transition: 0.3s ease;
        }

            button:hover {
                color: #fff;
                border-color: #fff;
                background: rgba(255, 255, 255, 0.15);
            }



        /* Responsive image styling */
        .Image1 {
            width: 100px;
            height: 100px;
            position: static;
            left: 50%;
        }

        input[type="text"] {
        }

        body {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 96vh;
            width: 100%;
            background: url(../../wwwroot/IITH_Theme/images/IITHIcons/LoginBackground.jpg) no-repeat;
            background-position: center;
            background-size: cover;
        }
    </style>


    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>


<body id="contbod">
    <div class="wrapper">
        <form runat="server" id="MasterPageForm1">
            <div>
            </div>
            <br />

            <div>
                <asp:Image
                    ID="Image2" CssClass="Image1" runat="server"  Height="123px" ImageUrl="~/wwwroot/IITH_Theme/images/IITHIcons/logo.png" Style="margin-left: -20px;width:185px !important;display:none" />
                <div class="page">

                    <h4 id="id-company-text" style="color: #484B4D; font-size: 18px; margin-left: 3%; margin-top: -1px; font-weight: bold;display:none">@Health Tech Platform</h4>
                </div>
                <br />

                <div class="main">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </div>
            </div>
        </form>
       
        <hr style="border: 1px solid gray;margin-top:8% !important;" />

        <div class="center" style="color: black;text-align: left;margin-top:9% !important">
           
            <span style="font-weight: 500;">Application Developed By </span><span style="font-weight: 700;">Vision Plus:</span>
           <br />
            <strong>Email:</strong> <a href="info@visionplus.com.pk" style="color: black; font-weight: 500;">info@visionplus.com.pk</a>
            <br />
            <strong>Contact:</strong> <span style="font-weight: 500;"> 042-35947952</span>
        </div>
    </div>





    <script type="text/javascript">
        //$(window).load(function () {
        //    $("#loading").fadeOut(1000);
        //});
    </script>


</body>
</html>





