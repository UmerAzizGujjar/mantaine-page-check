                    <div class="container-fluid">
                        <div class="page-header pr-title-bar">
                            <h1>
                                <asp:Label ID="lbl1" runat="server" Text=""></asp:Label>
                                <small>
                                    <i class="ace-icon fa fa-angle-double-right"></i>&nbsp;&nbsp;
                                <asp:Label ID="lbl2" Style="color: #484b4d !important" runat="server" Text=""></asp:Label>
                                </small>
                            </h1>
                        </div>
                        <script type="text/javascript">
                            // "OPD » OPD": when the breadcrumb only repeats the title (or is empty) show the title alone
                            (function () {
                                var t = document.querySelector('.page-header [id$="lbl1"]');
                                var s = document.querySelector('.page-header [id$="lbl2"]');
                                if (!t || !s) return;
                                var a = (t.textContent || '').trim().toLowerCase(), b = (s.textContent || '').trim().toLowerCase();
                                if (b === '' || a === b) { var sm = s.closest('small'); if (sm) sm.style.display = 'none'; }
                            })();

                            // Forms that already have a .pr-meta-bar (PR #, Date, Status ...): show the page title inside that bar
                            // (left side) and hide the separate title strip. Pages without the bar keep the .pr-title-bar strip.
                            // Bars that already carry their own .meta-title (Vendor, Product, Receipts ...) keep it; a bar with an
                            // empty .meta-left (Test Definition, Register Patient, Voucher ...) gets the title there.
                            function placePageTitle() {
                                var bar = document.querySelector('.container-fluid .pr-meta-bar');
                                var head = document.querySelector('.container-fluid > .page-header.pr-title-bar');
                                if (!head) return;
                                // form has its own title banner (bp-/opd-/ipd-/emp-/apt-meta-title): drop the duplicate strip
                                var banner = document.querySelector('.container-fluid [class*="-meta-title"]:not(.pr-meta-title)');
                                if (banner && (banner.textContent || '').trim() !== '') { head.style.display = 'none'; return; }
                                if (!bar) return;
                                var own = bar.querySelector('.meta-title, .pr-meta-title');
                                if (own && (own.textContent || '').trim() !== '') { head.style.display = 'none'; return; }
                                var t = head.querySelector('[id$="lbl1"]'), s = head.querySelector('[id$="lbl2"]');
                                var main = t ? (t.textContent || '').trim() : '';
                                var sub = s ? (s.textContent || '').trim() : '';
                                if (!main) return;                              // no title set: leave the normal strip alone
                                var box = document.createElement('div');
                                box.className = 'pr-meta-title';
                                var m = document.createElement('span');
                                m.className = 'pr-meta-title-main';
                                m.textContent = main;
                                box.appendChild(m);
                                if (sub && sub.toLowerCase() !== main.toLowerCase()) {
                                    var sp = document.createElement('span');
                                    sp.className = 'pr-meta-title-sub';
                                    sp.textContent = '» ' + sub;
                                    box.appendChild(sp);
                                }
                                var target = bar.querySelector('.meta-left') || bar;
                                target.insertBefore(box, target.firstChild);
                                head.style.display = 'none';
                            }
                            document.addEventListener('DOMContentLoaded', function () {
                                placePageTitle();
                                // UpdatePanel partial postbacks re-render the bar: put the title back each time
                                try {
                                    if (window.Sys && Sys.WebForms && Sys.WebForms.PageRequestManager) {
                                        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(placePageTitle);
                                    }
                                } catch (e) { }
                            });
                        </script>
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </div>
