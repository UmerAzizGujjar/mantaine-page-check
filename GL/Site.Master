                        <div class="col-lg-2 col-md-2 col-sm-2">
                            <div id="headerWelcome" class="header-user-dropdown">
                                <div class="dropdown" style="margin-top: -15px;">
                                    <button class="btn user-btn dropdown-toggle btn-primry" type="button" id="userDropdown"
                                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-user mr-2"></i>
                                        <asp:Label ID="LoginName" runat="server" />
                                        <i class="fa fa-caret-down ml-2"></i>
                                        <!-- Added arrow down icon -->
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">

                                        <!-- Logout with icon -->
                                        <a href="~/Login.aspx" style="text-decoration: none; color: black !important" class="dropdown-item" onclick="document.getElementById('<%= HeadLoginStatus.ClientID %>').click(); return false;">
                                            <i class="fa fa-sign-out mr-2" aria-hidden="true"></i>Log Out
                                        </a>

                                        <!-- Hidden actual logout control -->
                                        <asp:LoginStatus ID="HeadLoginStatus" runat="server"
                                            LogoutAction="Redirect"
                                            LogoutText=""
                                            LogoutPageUrl="~/Login.aspx"
                                            Style="display: none;"
                                            OnLoggedOut="HeadLoginStatus_LoggedOut" />


                                        <div class="dropdown-divider"></div>
                                        <!-- Change Password -->
                                        <a href="/Modules/Accounts/PasswordChange.aspx" style="text-decoration: none; color: Black !important" class="dropdown-item">
                                            <i class="fa fa-key mr-2" aria-hidden="true"></i>Change Password
                                        </a>
                                    </div>



                                </div>
                            </div>
                        </div>




                    </div>

                </div>

