                    <div id="clear" style="clear: both; height: 10px;"></div>
                    <div class="ace-settings-container" style="display: none" id="ace-settings-container">
                        <div class="btn btn-app btn-xs btn-warning ace-settings-btn" id="ace-settings-btn">
