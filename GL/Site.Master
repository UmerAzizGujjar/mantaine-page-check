        </div>
    </form>

    <script type="text/javascript">
        jQuery(function ($) {
            $('.sidebar .nav li:nth-child(1) i').addClass("fa-tachometer");
            $('.sidebar .nav > li:nth-child(1)').css('width', '160px');
            $('.sidebar .nav li:nth-child(2) i').addClass("fa-bed");
            $('.sidebar .nav > li:nth-child(2)').css('width', '160px');
            $('.sidebar .nav li:nth-child(3) i').addClass("fa-table");
            $('.sidebar .nav li:nth-child(4) i').addClass("fa-group");
            $('.sidebar .nav li:nth-child(5) i').addClass("fa-hourglass-end");
            $('.sidebar .nav li:nth-child(8) i').addClass("fa-desktop");
            $('.sidebar .nav li:nth-child(6) i').addClass("fa-plus-square");
            $('.sidebar .nav li:nth-child(7) i').addClass("fa-bank");
            $('.sidebar .nav li:nth-child(8) i').addClass("fa-tag");
            $('.sidebar .nav li:nth-child(9) i').addClass("fa-list-alt");
            $('.sidebar .nav li:nth-child(10) i').addClass("fa-pencil-square-o");
            $('.sidebar .nav li:nth-child(11) i').addClass("fa-desktop");
            $('.sidebar .nav li:nth-child(12) i').addClass("fa-tachometer");

            $('.nav li ul').each(function () {
                $(this).addClass("submenu");
            });

            $('.nav li').click(function () {
                debugger
                $(this).addClass('active').siblings().removeClass('active');
            });
        });
        $(document).ready(function () {
            debugger
            $('#ctl00_sidebar').delay(2000).fadeIn();
            var sessionTimeoutWarning ="<%= System.Configuration.ConfigurationManager.AppSettings["SessionTimeoutWarning"].ToString()%>";
            var sessionTimeout = "<%= Session.Timeout %>";
            var sTimeout = parseInt(sessionTimeoutWarning) * 55 * 1000;
            setTimeout('SessionWarning()', sTimeout);
            var time = "<%= DateTime.Now.ToString("h:mm:ss tt") %>";
            function SessionWarning() {
                var message = time + "\n Your session will expire in another " +
                    (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning)) +
                    " mins! Please Save the data before the session expires";
                alert(message);
            }
        });

        $("#ctl00_lblMessage").hide();
    </script>
    <script type="text/javascript">
        if ('ontouchstart' in document.documentElement) document.write("<script src='wwwroot/js/jquery.mobile.custom.min.js'>" + "<" + "/script>");
    </script >

            <script src="<%= Page.ResolveClientUrl("~/wwwroot/js/bootstrap.min.js") %>" type="text/javascript"></script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/js/ace-elements.min.js") %>" type="text/javascript"></script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/js/ace.min.js") %>" type="text/javascript"></script>
    <script type="text/javascript">

</script>
</body>

