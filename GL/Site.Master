    </script>
    <%-- Modern main menu (shared by every client theme): horizontal bar on desktop, slide-in drawer on phone/tablet --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/menu-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/menu-modern.css") %>" rel="stylesheet" type="text/css" />
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/menu-modern.js") %>?v=<%= Ver("~/wwwroot/lib/theme/menu-modern.js") %>" type="text/javascript" defer="defer"></script>
    <%-- Dark/Light mode (shared by every client theme) - keep these two lines LAST in <head> --%>
    <asp:PlaceHolder ID="DarkModeAssets" runat="server">
        <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/dark-theme.css") %>?v=<%= Ver("~/wwwroot/lib/theme/dark-theme.css") %>" rel="stylesheet" type="text/css" />
        <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/dark-pages.css") %>?v=<%= Ver("~/wwwroot/lib/theme/dark-pages.css") %>" rel="stylesheet" type="text/css" />
        <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/theme-toggle.js") %>?v=<%= Ver("~/wwwroot/lib/theme/theme-toggle.js") %>" type="text/javascript"></script>
    </asp:PlaceHolder>
    <%-- Modern data tables (DataTables + .table): loaded AFTER the dark-mode files on purpose --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/table-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/table-modern.css") %>" rel="stylesheet" type="text/css" />
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/table-modern.js") %>?v=<%= Ver("~/wwwroot/lib/theme/table-modern.js") %>" type="text/javascript" defer="defer"></script>
    <%-- One look for every date / time picker (theme colours + month/year drop-downs); loaded after the dark-mode files --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/datepicker-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/datepicker-modern.css") %>" rel="stylesheet" type="text/css" />
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/datepicker-modern.js") %>?v=<%= Ver("~/wwwroot/lib/theme/datepicker-modern.js") %>" type="text/javascript"></script>
    <%-- One size for every Bootstrap modal (900px x 80% height, centred; opt out with class="modal-free-size") --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/modal-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/modal-modern.css") %>" rel="stylesheet" type="text/css" />
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/modal-modern.js") %>?v=<%= Ver("~/wwwroot/lib/theme/modal-modern.js") %>" type="text/javascript"></script>
    <%-- Branch-wise warehouse dropdowns (sys_Parms "Branch Wise Ware House" = 01); forms opt in with BranchWareHouse.attach() --%>
    <script type="text/javascript">window.BranchWareHouseUrl = '<%= Page.ResolveUrl("~/Modules/Inventory/BranchWareHouse.ashx") %>';</script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/branch-warehouse.js") %>?v=<%= Ver("~/wwwroot/lib/theme/branch-warehouse.js") %>" type="text/javascript"></script>
    <%-- Checkboxes drawn as toggle switches on every form (opt out with class="no-switch") --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/form-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/form-modern.css") %>" rel="stylesheet" type="text/css" />
    <%-- Modern file / attachment fields (every input type="file"; CSS only) --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/file-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/file-modern.css") %>" rel="stylesheet" type="text/css" />
    <%-- Modern form / record pages (pf-* classes and .emr-page); nothing applies until a page uses them --%>
    <link href="<%= Page.ResolveClientUrl("~/wwwroot/lib/theme/page-form-modern.css") %>?v=<%= Ver("~/wwwroot/lib/theme/page-form-modern.css") %>" rel="stylesheet" type="text/css" />
</head>
<body class="no-skin" onload="releasemenu()">
    <form runat="server" id="MasterPageForm1">
        <asp:ToolkitScriptManager ID="cmManager" runat="server" EnablePageMethods="true" />
        <div class="page">
            <div class="loginDisplay">
                <div id="navbar" class="navbar navbar-default navbar-collapse h-navbar ace-save-state">
                    <div class="navbar-container ace-save-state row" id="navbar-container">
                           <div class="col-lg-3 col-md-4 col-sm-3">
        <a href="~/Modules/Dashboards/ShortCuts.aspx" runat="server" id="IHome" title="Haroon Estates">
            <asp:Image ID="imglogo" runat="server" CssClass="app-logo" ImageUrl="~/wwwroot/THEME_TIBBIT/images/CompanyImages/logo.png" />
        </a>
    </div>
    
    <!-- Middle Company Name -->
    <div class="col-lg-6 col-md-4 col-sm-6" style="display: flex; align-items: center; justify-content: center; height: 60px;">
        <asp:Label ID="lblCompanyNameCenter" runat="server" Text="" 
CssClass="app-title"></asp:Label>
    </div>
    
    <div class="col-lg-1 col-md-2 col-sm-1">
                            <!-- Bell Icon and Notification Dropdown (moved here) -->
                            <div id="notification" class="notification" runat="server">
                                <div class="navbar-buttons navbar-header" role="navigation">
                                    <ul class="nav ace-nav">
                                        <li class="" style="width: 90px !important; height: 60px;">
                                            <a data-toggle="dropdown" class="dropdown-toggle" href="#">
                                                <i class="ace-icon fa fa-bell icon-animated-bell" id="bell" style="font-size: 30px"></i>
                                                <span id="blink_notify" style="margin-left: 6px;" runat="server">
                                                    <span id="blink-notif" class="badge badge-important blink">
                                                        <asp:Label ID="lblTotal_Notifs" runat="server" Text="8"></asp:Label>


                                                    </span>
                                                </span>
                                            </a>
                                            <ul class="dropdown-menu-right dropdown-navbar navbar-pink dropdown-menu dropdown-caret dropdown-close">
                                                <li class="dropdown-header" style="text-align: left !important;">
                                                    <i class="ace-icon fa fa-bell" id="bellnotify"></i>
                                                    Notifications
                                                </li>
                                                <!-- Notification Items -->
                                                <li id="PurchaseRequisition" runat="server">
                                                    <a onclick="RedirectToPR()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Purchase Requisition</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblPR" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="RFQ" runat="server">
                                                    <a onclick="RedirectToRFQ()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Request For Quotation</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblRFQ" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="CS" runat="server">
                                                    <a onclick="RedirectToCS()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Comparative Statement</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblCS" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="PO" runat="server">
                                                    <a onclick="RedirectToPO()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Purchase Order</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblpo" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="IGP" runat="server">
                                                    <a onclick="RedirectToIGP()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>IGP</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lbligp" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GRN" runat="server">
                                                    <a onclick="RedirectToGRN()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-file-o"></i>GRN</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblgrn" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GIR" runat="server">
                                                    <a onclick="RedirectToGIR()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-file-o"></i>GIR</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblGIR" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GIN" runat="server">
                                                    <a onclick="RedirectToGIN()">
