            <div class="main-content">
                <div id="sidebar" runat="server" class="sidebar h-sidebar navbar-collapse collapse"></div>
                <div class="main">

                    <div style="clear: both; height: 10px;"></div>
                    <div class="row hamburger-row" style="margin-left:-13% !important; display:none  " >
                        <div class="col-2">
                            <button type="button" onclick="hideNavbar" id="hamburger" class="hamburger-btn" aria-label="Toggle navigation">
                                <span></span>
                                <span></span>
                                <span></span>
                            </button>

                        </div>
                    </div>
                    <div class="ace-settings-container" style="display: none" id="ace-settings-container">
                        <div class="btn btn-app btn-xs btn-warning ace-settings-btn" id="ace-settings-btn">
                            <i class="ace-icon fa fa-cog bigger-130"></i>
                        </div>
                        <div class="ace-settings-box clearfix" id="ace-settings-box">
                            <div class="pull-left width-50">
                                <div class="ace-settings-item">
                                    <div class="pull-left">
                                        <select id="skin-colorpicker" class="hide">
                                            <option data-skin="no-skin" value="#EFA63E">#EFA63E</option>
                                            <option data-skin="skin-1" value="#FDC303">#FDC303</option>
                                            <option data-skin="skin-2" value="#C6487E">#C6487E</option>
                                            <option data-skin="skin-3" value="#D0D0D0">#D0D0D0</option>
                                        </select>
                                    </div>
                                    <span>&nbsp; Choose Skin</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="container-fluid">
                        <div class="page-header">
                            <h1>
                                <asp:Label ID="lbl1" runat="server" Text=""></asp:Label>
                                <small>
                                    <i class="ace-icon fa fa-angle-double-right"></i>&nbsp;&nbsp;
                                <asp:Label ID="lbl2" Style="color: #484b4d !important" runat="server" Text=""></asp:Label>
                                </small>
                            </h1>
                        </div>
                        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                    </div>
                </div>
                <div class="clear"></div>
                <div>
                    <asp:Label ID="lblMessage" runat="server" />
                </div>
            </div>
        </div>
        <br />

        <div>
            <uc:Footer runat="server" ID="Footer" />

        </div>
    </form>

    <script type="text/javascript">
        jQuery(function ($) {
            $('.sidebar .nav li:nth-child(1) i').addClass("fa-tachometer");
            $('.sidebar .nav li:nth-child(2) i').addClass("fa-bed");
            $('.sidebar .nav > li:nth-child(2)').css('width', '160px');
            $('.sidebar .nav li:nth-child(3) i').addClass("fa-table");
            $('.sidebar .nav li:nth-child(4) i').addClass("fa-group");
            $('.sidebar .nav li:nth-child(5) i').addClass("fa-hourglass-end");
            $('.sidebar .nav li:nth-child(8) i').addClass("fa-desktop");
            $('.sidebar .nav li:nth-child(6) i').addClass("fa-plus-square");
            $('.sidebar .nav li:nth-child(7) i').addClass("fa-bank");
            $('.sidebar .nav li:nth-child(8) i').addClass("fa-tag");
            $('.sidebar .nav li:nth-child(9) i').addClass("fa-list-alt");
            $('.sidebar .nav li:nth-child(10) i').addClass("fa-pencil-square-o");
            $('.sidebar .nav li:nth-child(11) i').addClass("fa-desktop");
            $('.sidebar .nav li:nth-child(12) i').addClass("fa-tachometer");
            $('.sidebar .nav li:nth-child(13) i').addClass("fa-tachometer");

            $('.nav li ul').each(function () {
                $(this).addClass("submenu");
            });

            $('.nav li').click(function () {
                debugger
                $(this).addClass('active').siblings().removeClass('active');
            });
        });
        $(document).ready(function () {

            debugger
            $('#ctl00_sidebar').delay(2000).fadeIn();
            var sessionTimeoutWarning ="<%= System.Configuration.ConfigurationManager.AppSettings["SessionTimeoutWarning"].ToString()%>";
            var sessionTimeout = "<%= Session.Timeout %>";
            var sTimeout = parseInt(sessionTimeoutWarning) * 55 * 1000;
            setTimeout('SessionWarning()', sTimeout);
            var time = "<%= DateTime.Now.ToString("h:mm:ss tt") %>";
            function SessionWarning() {
                var message = time + "\n Your session will expire in another " +
                    (parseInt(sessionTimeout) - parseInt(sessionTimeoutWarning)) +
                    " mins! Please Save the data before the session expires";
                alert(message);
            }
        });
        $(document).ready(function () {
            const $div = $('#ctl00_sidebar');
            const $button = $('#hamburger');

            // Show the div (by removing .hide-force) on button click
            $button.on('click', function (e) {
                e.stopPropagation(); // Prevent document click from firing
                $div.removeClass('hide-force');
            });

            // Hide div if click is outside both the div and the button
            $(document).on('click', function (event) {
                if (
                    !$div.is(event.target) && $div.has(event.target).length === 0
                ) {
                    $div.addClass('hide-force');
                }
            });
        });

        $("#ctl00_lblMessage").hide();
    </script>
    <script type="text/javascript">
        if ('ontouchstart' in document.documentElement) document.write("<script src='wwwroot/Tibbit_theme/js/jquery.mobile.custom.min.js'>" + "<" + "/script>");
    </script >

            <script src="<%= Page.ResolveClientUrl("~/wwwroot/Tibbit_theme/js/bootstrap.min.js") %>" type="text/javascript"></script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/Tibbit_theme/js/ace-elements.min.js") %>" type="text/javascript"></script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/Tibbit_theme/js/ace.min.js") %>" type="text/javascript"></script>
    <script src="<%= Page.ResolveClientUrl("~/wwwroot/Tibbit_theme/js/swalalert.js") %>" type="text/javascript"></script>


    <script type="text/javascript">

</script>
</body>

</html>
