    <script type="text/javascript">
     

      
        $(document).ajaxError(function (event, xhr, settings, thrownError) {
            console.error("AJAX Error:", xhr.status, thrownError);

            if (xhr.status === 500) {
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response && response.redirect) {
                    
                        window.location.href = response.redirect;
                        return;
                    }
                } catch (e) { }

              
                showToast("A server error occurred. Please try again or contact support.", "error");
            }
            else if (xhr.status === 404) {
                showToast("Requested resource not found.", "warning");
            }
            else {
                showToast("Network error. Please check your connection.", "warning");
            }
        });

      
        window.onerror = function (message, source, lineno, colno, error) {
           

            return true;
        };

        
        window.addEventListener('unhandledrejection', function (event) {
            console.error("Unhandled Promise Rejection:", event.reason);
            showToast("Something went wrong. Please try again.", "error");
            event.preventDefault();
        });

     
        function showToast(message, type) {
         
            if (typeof toastr !== 'undefined') {
                toastr[type](message);
            }
            else if (typeof Swal !== 'undefined') {
                Swal.fire("Error", message, "error");
            }
            else {
                alert(message); 
            }
        }
    </script>



    <script type="text/javascript">
        $(document).ready(function () {
           

            const allowedExtensions = ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.png', '.jpg', '.jpeg'];

            const allowedMimes = [
                'application/pdf',
                'application/msword',
                'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
                'application/vnd.ms-excel',
                'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
                'image/png',
                'image/jpeg',
                'image/jpg'
            ];

            const maxSize = 10 * 1024 * 1024; // 10 MB

          
            $(document).on('change', 'input[type="file"]', function () {
                const file = this.files[0];
                if (!file) return;

                const fileName = file.name.toLowerCase();
                const fileExtension = fileName.substring(fileName.lastIndexOf('.'));
                const fileType = file.type;
                const fileSize = file.size;

     
                if (!allowedExtensions.includes(fileExtension)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid File Type',
                        text: 'Only PDF, Word, Excel, PNG, JPG, and JPEG files are allowed.',
                        confirmButtonText: 'OK',
                        customClass: {
                            popup: 'swal-big-popup',
                            title: 'swal-big-title',
                            htmlContainer: 'swal-big-text'
                        }
                    });
                    this.value = '';
                    return;
                }

                
                if (!allowedMimes.includes(fileType)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Unsupported File',
                        text: 'File type not allowed. Please upload a valid file.',
                        confirmButtonText: 'OK',
                        customClass: {
                            popup: 'swal-big-popup',
                            title: 'swal-big-title',
                            htmlContainer: 'swal-big-text'
                        }
                    });
                    this.value = '';
                    return;
                }

                if (fileSize > maxSize) {
                    Swal.fire({
                        icon: 'error',
                        title: 'File Too Large',
                        text: 'Maximum file size is 10 MB.',
                        confirmButtonText: 'OK',
                        customClass: {
                            popup: 'swal-big-popup',
                            title: 'swal-big-title',
                            htmlContainer: 'swal-big-text'
                        }
                    });
                    this.value = '';
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'File Accepted',
                    text: `${file.name} is valid and ready to upload.`,
                    confirmButtonText: 'Got it',
                    timer: 1500,
                    timerProgressBar: true,
                    customClass: {
                        popup: 'swal-big-popup',
                        title: 'swal-big-title',
                        htmlContainer: 'swal-big-text'
                    }
                });

                console.log('Valid file selected:', file.name, 'Size:', fileSize, 'bytes');
            });
        });
</script>
<script type="text/javascript">
   <%-- (function () {
        // Pages can opt out by setting window.skipDevToolsCheck = true before the master loads
        if (window.skipDevToolsCheck === true) { return; }

        var loginUrl = '<%= ResolveUrl("~/Login.aspx") %>';
        var acted = false;

        // DevTools found: hide the page so there is nothing to read, show the notice, then end the session
        function forceLogout() {
            if (acted) { return; }
            acted = true;

            var form = document.forms[0];
            if (form) { form.style.display = 'none'; }

            // Login.aspx clears the server session when it loads, so redirecting there logs the user out
            var goLogout = function () {
                window.location.href = loginUrl;
            };
            if (typeof Swal === 'undefined') {
                alert('Developer Tools detected! You will be logged out.');
                goLogout();
                return;
            }

            // Count down 5 seconds; OK logs out now, and the timer logs out when it reaches 0
            var secondsLeft = 5;
            var countdown = null;
            Swal.fire({
                icon: 'warning',
                title: 'Developer Tools detected',
                html: 'You will be logged out in <b id="dtSeconds">5</b> seconds.',
                timer: 5000,
                timerProgressBar: true,
                allowOutsideClick: false,
                allowEscapeKey: false,
                confirmButtonText: 'OK',
                didOpen: function () {
                    countdown = setInterval(function () {
                        secondsLeft--;
                        var b = document.getElementById('dtSeconds');
                        if (b) { b.textContent = Math.max(secondsLeft, 0); }
                        if (secondsLeft <= 0) { clearInterval(countdown); }
                    }, 1000);
                },
                willClose: function () {
                    clearInterval(countdown);
                }
            }).then(goLogout);
        }

        // Console probe: the getter runs only when the console serializes the object.
        // Recent Chrome versions do not always run it, so it is a second check only.
        var probe = new Image();
        Object.defineProperty(probe, 'id', {
            get: function () { forceLogout(); }
        });

        // Debugger timing: "debugger" pauses only while DevTools is open, so a long pause means DevTools is open.
        function devtoolsOpenByTiming() {
            var started = performance.now();
            debugger;
            return performance.now() - started > 100;
        }

        setInterval(function () {
            console.log(probe);
            if (devtoolsOpenByTiming()) { forceLogout(); }
        }, 1000);

        // Keep Ctrl+U (view source) blocked; it does not log anyone out
        // Block view source (Ctrl+U) before the page or any input can see it; no logout for this key
        document.addEventListener('keydown', function (e) {
            var isU = e.keyCode === 85 || e.key === 'u' || e.key === 'U';
            if (e.ctrlKey && isU) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        }, true);    })();--%>
</script>
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>

    <style type="text/css">
        /* ===== Small screens: page-level helpers (the MENU itself lives in wwwroot/lib/theme/menu-modern.css) ===== */
        @media screen and (max-width: 995px) {
            .container-fluid {
                padding-left: 0px !important;
                padding-right: 0px !important;
            }

            .headerWelcome {
                font-size: 50%;
            }

            .table-container {
                overflow-x: auto !important;
                max-height: 600px !important;
                height: 100% !important;
                padding: 10px !important;
                box-sizing: border-box !important;
            }

            select {
                width: 100% !important;
                height: 34px !important;
            }

            body {
                background-color: #fff !important;
                min-height: 100% !important;
                padding-bottom: 0 !important;
                font-family: 'Open Sans' !important;
                font-size: 13px !important;
                color: black !important;
                line-height: 1.5 !important;
                font-weight: bold !important;
            }
        }

        @media screen and (max-width: 589px) {
            #welCome {
                display: none;
            }
        }

        @media screen and (max-width: 526px) {
            #ctl00_LoginName {
                display: none;
            }

            #LoginSign {
                display: none;
            }
        }

        .span1 {
            padding-top: 18px;
        }

        .ui-button-text-only .ui-button-text {
            padding: .4em 1em;
        }

        .span2 {
            padding-top: 18px;
        }

        .main input {
            margin-bottom: 6px;
        }

        .main textarea {
            margin-bottom: 6px;
        }

        .main select {
            margin-bottom: 6px;
        }

        page-header h1 {
            margin-left: 0;
            margin-right: 0;
        }



        .tokeninput {
            box-shadow: 2px -3px 5px rgba(0, 0, 0, 0.2) !important;
        }

        .notification {
            position: absolute;
            top: 0;
        }

        .notif-detail {
            background-color: #ebebeb;
            position: relative;
            text-align: left;
            top: -5px;
            display: block;
            width: 258px;
            z-index: 999;
            display: none;
        }

        .header-user-dropdown {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 10px 15px;
            margin-top: 17px;
            position: relative;
        }

        .user-btn {
            background-color: #5a5a5a;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 6px 16px;
            font-weight: bold;
            display: flex;
            align-items: center;
            transition: background-color 0.3s ease;
        }

            .user-btn:hover {
                background-color: #444;
                color: #fff;
            }

        .dropdown-menu {
            min-width: 120px;
            padding: 0.5rem;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            margin-top: 5px;
            position: absolute;
            border: none !important;
            left: 1px; /* Align the dropdown menu to the left edge of the button */
        }

        .logout-btn {
            background-color: #f7941d;
            color: black;
            font-weight: bold;
            text-align: center;
            border-radius: 6px;
            padding: 6px 12px;
            display: block;
            width: 100%;
            margin-top: -5px;
        }

            .logout-btn:hover {
                background-color: #e0850f;
                color: white;
            }

        .dropdown-item i {
            color: black
        }

        .dropdown-divider {
            margin: 0.3rem 0;
        }

        .ml-2 {
            margin-left: 0.5rem;
        }

        .mr-2 {
            margin-right: 0.5rem;
        }
    </style>
