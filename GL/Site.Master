<body class="no-skin" onload="releasemenu()">
    <form runat="server" id="MasterPageForm1">
        <asp:ToolkitScriptManager ID="cmManager" runat="server" EnablePageMethods="true" />
        <div class="page">
            <div class="loginDisplay" style="background-color: #438eb9">
                <div id="navbar" style="height: 60px !important" class="navbar navbar-default navbar-collapse h-navbar ace-save-state">
                    <div class="navbar-container ace-save-state row" id="navbar-container">
                        <!-- Left Side Logo + Company -->
                        <div class="col-lg-8 col-md-4  col-sm-3">
                            <a href="~/Modules/Dashboards/ShortCuts.aspx" runat="server" id="IHome" title="Haroon Estates">
                                <asp:Image ID="imglogo" runat="server" Style="margin: 0px; margin-left: -10px; border-radius: 0px; height: 66px !important; margin-top: -5px !important; width: 108px;" ImageUrl="~/wwwroot/StandardTheme\images\Standard_icons/logo.png" />
                                <asp:Label ID="lblCompanyName" runat="server" Text="" Style="margin-left: 20px; display: none; font-weight: bold"></asp:Label>
                            </a>

                        </div>
                        <div class="col-lg-1 col-md-4  col-sm-1">
                            <!-- Bell Icon and Notification Dropdown (moved here) -->
                        <div id="notification" class="notification" runat="server">
                                <div class="navbar-buttons navbar-header" role="navigation">
                                    <ul class="nav ace-nav">
                                        <li class="" style="width: 90px !important; height: 60px;">
                                            <a data-toggle="dropdown" class="dropdown-toggle" href="#" style="background-color: transparent!important">
                                                <i class="ace-icon fa fa-bell icon-animated-bell" id="bell" style="font-size: 30px"></i>
                                                <span id="blink_notify" style="margin-left: 6px;" runat="server">
                                                    <span id="blink-notif" class="badge badge-important blink">
                                                        <asp:Label ID="lblTotal_Notifs" runat="server" Text="8"></asp:Label>


                                                    </span>
                                                </span>
                                            </a>
                                            <ul class="dropdown-menu-right dropdown-navbar navbar-pink dropdown-menu dropdown-caret dropdown-close">
                                                <li class="dropdown-header" style="text-align: left !important;">
                                                    <i class="ace-icon fa fa-bell" id="bellnotify"></i>
                                                    Notifications
                                                </li>
                                                <!-- Notification Items -->
                                                <li id="PurchaseRequisition" runat="server">
                                                    <a onclick="RedirectToPR()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Purchase Requisition</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblPR" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="RFQ" runat="server">
                                                    <a onclick="RedirectToRFQ()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Request For Quotation</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblRFQ" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="CS" runat="server">
                                                    <a onclick="RedirectToCS()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Comparative Statement</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblCS" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="PO" runat="server">
                                                    <a onclick="RedirectToPO()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>Purchase Order</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblpo" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="IGP" runat="server">
                                                    <a onclick="RedirectToIGP()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-home"></i>IGP</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lbligp" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GRN" runat="server">
                                                    <a onclick="RedirectToGRN()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-file-o"></i>GRN</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblgrn" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GIR" runat="server">
                                                    <a onclick="RedirectToGIR()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-file-o"></i>GIR</span>
                                                            <span class="pull-right badge badge-info">
                                                                <asp:Label ID="lblGIR" runat="server" Text="8"></asp:Label></span>
                                                        </div>
                                                    </a>
                                                </li>
                                                <li id="GIN" runat="server">
                                                    <a onclick="RedirectToGIN()">
                                                        <div class="clearfix">
                                                            <span class="pull-left"><i class="btn btn-xs no-hover btn-info fa fa-file-o"></i>GIN</span>
                                                            <span class="pull-right badge badge-info">
